{
  "openapi": "3.0.3",
  "info": {
    "title": "b2b-promo API",
    "version": "1.0.0",
    "description": "식자재 유통 B2B 거래처 프로모션 조회/참여 서비스 API. 3일/1인 개발 MVP 범위(3-prd.md, 1-domain-definition.md 기준)."
  },
  "servers": [
    { "url": "http://localhost:3000", "description": "로컬 개발 서버" }
  ],
  "tags": [
    { "name": "auth", "description": "인증 (FR-1)" },
    { "name": "promotions", "description": "프로모션 관리/조회 (FR-2, FR-3)" },
    { "name": "applications", "description": "참여 신청 (FR-3)" },
    { "name": "users", "description": "마이페이지 (FR-4)" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "로그인 응답의 access token을 사용한다. 만료 시 /api/auth/refresh로 재발급한다 (FR-1.4)."
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "example": "이미 참여 신청한 프로모션입니다" }
        },
        "required": ["error"]
      },
      "Role": {
        "type": "string",
        "enum": ["admin", "buyer"]
      },
      "PromotionType": {
        "type": "string",
        "enum": ["discount", "gift", "tasting"],
        "description": "discount=가격할인, gift=사은품 증정, tasting=신제품 시식"
      },
      "PromotionStatus": {
        "type": "string",
        "enum": ["scheduled", "active", "ended"],
        "description": "scheduled=예정, active=진행, ended=종료 (BR-4)"
      },
      "ApplicationStatus": {
        "type": "string",
        "enum": ["applied", "cancelled"],
        "description": "applied=신청, cancelled=취소 (BR-1)"
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "email": { "type": "string", "format": "email", "example": "buyer@example.com" },
          "role": { "$ref": "#/components/schemas/Role" },
          "name": { "type": "string", "example": "김담당" },
          "company_name": { "type": "string", "example": "행복식당" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "Prize": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "promotion_id": { "type": "integer", "example": 1 },
          "name": { "type": "string", "example": "무료 시식 쿠폰" }
        }
      },
      "Promotion": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "type": { "$ref": "#/components/schemas/PromotionType" },
          "title": { "type": "string", "example": "여름맞이 가격할인 프로모션" },
          "description": { "type": "string", "nullable": true, "example": "8월 한정 전품목 10% 할인" },
          "status": { "$ref": "#/components/schemas/PromotionStatus" },
          "has_game": { "type": "boolean", "example": true },
          "start_date": { "type": "string", "format": "date", "example": "2026-08-01" },
          "end_date": { "type": "string", "format": "date", "example": "2026-08-31" },
          "created_at": { "type": "string", "format": "date-time" },
          "prizes": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Prize" },
            "description": "has_game=true인 경우에만 포함. 상세 조회/등록/수정/게시·종료 응답에만 포함되며, 목록 조회(GET /api/promotions) 응답에는 포함되지 않는다"
          }
        }
      },
      "PromotionCreateRequest": {
        "type": "object",
        "required": ["type", "title", "start_date", "end_date", "has_game"],
        "properties": {
          "type": { "$ref": "#/components/schemas/PromotionType" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "start_date": { "type": "string", "format": "date" },
          "end_date": { "type": "string", "format": "date" },
          "has_game": { "type": "boolean" },
          "prizes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name"],
              "properties": { "name": { "type": "string", "example": "무료 시식 쿠폰" } }
            },
            "description": "has_game=true일 때 경품 목록 (FR-2.2). 비어 있으면 등록은 가능하나 게시는 거부된다 (EX-3)"
          }
        }
      },
      "PromotionUpdateRequest": {
        "type": "object",
        "description": "has_game은 수정할 수 없다(등록 시점에만 결정, 서버가 무시함). prizes를 포함해 보내면 기존 경품을 전량 삭제 후 재등록한다",
        "properties": {
          "type": { "$ref": "#/components/schemas/PromotionType" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "start_date": { "type": "string", "format": "date" },
          "end_date": { "type": "string", "format": "date" },
          "prizes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name"],
              "properties": { "name": { "type": "string" } }
            }
          }
        }
      },
      "PromotionStatusChangeRequest": {
        "type": "object",
        "required": ["action"],
        "properties": {
          "action": {
            "type": "string",
            "enum": ["publish", "end"],
            "description": "publish: scheduled→active(게시), end: active→ended(종료) (BR-4)"
          }
        }
      },
      "Application": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "promotion_id": { "type": "integer", "example": 1 },
          "buyer_id": { "type": "integer", "example": 3 },
          "status": { "$ref": "#/components/schemas/ApplicationStatus" },
          "prize_id": { "type": "integer", "nullable": true, "example": 2 },
          "prize_name": { "type": "string", "nullable": true, "example": "무료 시식 쿠폰", "description": "당첨 경품명(있는 경우)" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "MyApplication": {
        "allOf": [
          { "$ref": "#/components/schemas/Application" },
          {
            "type": "object",
            "properties": {
              "promotion_title": { "type": "string", "example": "여름맞이 가격할인 프로모션" },
              "promotion_status": { "$ref": "#/components/schemas/PromotionStatus" }
            }
          }
        ]
      },
      "ApplicantView": {
        "type": "object",
        "description": "관리자용 프로모션별 참여 신청 현황 (FR-2.5)",
        "properties": {
          "application_id": { "type": "integer", "example": 1 },
          "buyer_name": { "type": "string", "example": "김담당" },
          "company_name": { "type": "string", "example": "행복식당" },
          "status": { "$ref": "#/components/schemas/ApplicationStatus" },
          "prize_name": { "type": "string", "nullable": true, "example": "무료 시식 쿠폰" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "SignupRequest": {
        "type": "object",
        "required": ["email", "password", "name", "company_name"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "format": "password", "description": "서버는 4개 필드의 존재 여부만 검증하며 길이 제약은 강제하지 않는다" },
          "name": { "type": "string" },
          "company_name": { "type": "string" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "format": "password" }
        }
      },
      "TokenPairResponse": {
        "type": "object",
        "properties": {
          "access_token": { "type": "string" },
          "refresh_token": { "type": "string" },
          "user": { "$ref": "#/components/schemas/User" }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "required": ["refresh_token"],
        "properties": {
          "refresh_token": { "type": "string" }
        }
      },
      "RefreshResponse": {
        "type": "object",
        "properties": {
          "access_token": { "type": "string" },
          "refresh_token": { "type": "string", "description": "재발급 시 로테이션된 새 refresh token (FR-1.4)" }
        }
      },
      "LogoutRequest": {
        "type": "object",
        "required": ["refresh_token"],
        "properties": {
          "refresh_token": { "type": "string" }
        }
      },
      "UserUpdateRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "company_name": { "type": "string" }
        }
      },
      "PasswordChangeRequest": {
        "type": "object",
        "required": ["current_password", "new_password"],
        "properties": {
          "current_password": { "type": "string", "format": "password" },
          "new_password": { "type": "string", "format": "password", "minLength": 8 }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "비즈니스 규칙 위반 등 잘못된 요청",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "Unauthorized": {
        "description": "인증 실패 (토큰 없음/만료/무효)",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "Forbidden": {
        "description": "권한 없음 (예: buyer가 관리자 API 접근)",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "NotFound": {
        "description": "존재하지 않는 리소스",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      }
    }
  },
  "paths": {
    "/api/auth/signup": {
      "post": {
        "tags": ["auth"],
        "summary": "거래처 담당자 회원가입",
        "description": "FR-1.1, EX-5 참조. role은 서버에서 buyer로 고정 생성된다.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SignupRequest" } } }
        },
        "responses": {
          "201": {
            "description": "회원가입 성공",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          },
          "400": {
            "description": "이미 등록된 이메일 (EX-5) 또는 필수값 누락",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["auth"],
        "summary": "로그인 및 토큰 발급",
        "description": "FR-1.2 참조. 로그인 성공 시 access token과 refresh token을 발급한다.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } }
        },
        "responses": {
          "200": {
            "description": "로그인 성공",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TokenPairResponse" } } }
          },
          "401": {
            "description": "이메일 또는 비밀번호 불일치",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": ["auth"],
        "summary": "access token 재발급",
        "description": "FR-1.4 참조. refresh token으로 새 access token을 발급하며, refresh token은 재발급 시 로테이션된다.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RefreshRequest" } } }
        },
        "responses": {
          "200": {
            "description": "재발급 성공",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RefreshResponse" } } }
          },
          "401": {
            "description": "refresh token 만료 또는 무효 (재로그인 필요)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["auth"],
        "summary": "로그아웃",
        "description": "FR-1.5 참조. 전달된 refresh token을 무효화(삭제)한다.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LogoutRequest" } } }
        },
        "responses": {
          "204": { "description": "로그아웃 성공" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/promotions": {
      "get": {
        "tags": ["promotions"],
        "summary": "프로모션 목록 조회",
        "description": "FR-3.1(거래처: 진행/예정만), FR-2.4(관리자: 전체 목록에서 게시/종료 관리) 참조. buyer는 status 필터가 scheduled/active로 제한되며 ended는 조회되지 않는다.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": { "$ref": "#/components/schemas/PromotionStatus" },
            "description": "상태 필터(탭 UI). buyer는 scheduled/active만 지정 가능"
          }
        ],
        "responses": {
          "200": {
            "description": "목록 조회 성공",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Promotion" } }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["promotions"],
        "summary": "프로모션 등록 (관리자)",
        "description": "FR-2.1, FR-2.2, BR-4 참조. 등록 시 상태는 항상 scheduled로 생성된다.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PromotionCreateRequest" } } }
        },
        "responses": {
          "201": {
            "description": "등록 성공",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Promotion" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/promotions/{id}": {
      "get": {
        "tags": ["promotions"],
        "summary": "프로모션 상세 조회",
        "description": "FR-3.1 참조. 게임 적용 프로모션은 경품 목록을 함께 반환한다.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Promotion" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "tags": ["promotions"],
        "summary": "프로모션 수정 (관리자)",
        "description": "FR-2.3 참조.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PromotionUpdateRequest" } } }
        },
        "responses": {
          "200": {
            "description": "수정 성공",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Promotion" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/promotions/{id}/status": {
      "patch": {
        "tags": ["promotions"],
        "summary": "프로모션 게시/종료 상태 전환 (관리자)",
        "description": "FR-2.4, BR-4, EX-3 참조. publish(scheduled→active) 또는 end(active→ended)만 허용한다. has_game=true인데 경품이 0건이면 게시(publish)를 거부한다 (EX-3).",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PromotionStatusChangeRequest" } } }
        },
        "responses": {
          "200": {
            "description": "상태 전환 성공",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Promotion" } } }
          },
          "400": {
            "description": "허용되지 않는 상태 전환(BR-4) 또는 경품 없는 게임 프로모션 게시 시도(EX-3)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/promotions/{id}/applications": {
      "post": {
        "tags": ["applications"],
        "summary": "프로모션 참여 신청",
        "description": "FR-3.2, BR-1, BR-2, BR-3, EX-1, EX-2 참조. 게임 적용 프로모션은 신청 즉시 서버가 경품을 무작위 추첨하여 결과를 확정해 응답에 포함한다. 취소 후 재신청은 기존 레코드를 재사용하며 재추첨한다.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "프로모션 id" }
        ],
        "responses": {
          "201": {
            "description": "신청 성공 (게임 적용 시 prize_id/prize_name에 추첨 결과 포함)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Application" } } }
          },
          "400": {
            "description": "종료/미게시 프로모션 신청 시도(BR-3, EX-2) 또는 이미 신청한 프로모션에 중복 신청 시도(BR-1, EX-1)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "get": {
        "tags": ["promotions"],
        "summary": "프로모션별 참여 신청 현황 조회 (관리자)",
        "description": "FR-2.5 참조. 신청자, 상태, 당첨 결과를 함께 반환한다. 존재하지 않는 프로모션 id를 조회해도 404가 아닌 빈 배열을 200으로 반환한다(프로모션 존재 여부를 별도로 검증하지 않음).",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "프로모션 id" }
        ],
        "responses": {
          "200": {
            "description": "조회 성공 (해당 프로모션에 신청 내역이 없거나 프로모션이 존재하지 않으면 빈 배열)",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ApplicantView" } }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/applications/me": {
      "get": {
        "tags": ["applications"],
        "summary": "내 참여 신청 목록 조회",
        "description": "FR-3.4 참조. 당첨 결과(있는 경우)를 포함해 반환한다.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/MyApplication" } }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/applications/{id}/cancel": {
      "patch": {
        "tags": ["applications"],
        "summary": "참여 신청 취소",
        "description": "FR-3.3, BR-1 참조. 신청 레코드의 상태를 applied에서 cancelled로 전환한다. 레코드를 삭제하지 않으며, 재신청 시 동일 레코드가 재사용된다. role 제한은 없으며(본인 신청이면 관리자/거래처 담당자 모두 호출 가능), 존재하지 않는 id이거나 본인 소유가 아닌 신청 id는 403이 아닌 404로 응답한다.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "신청(application) id" }
        ],
        "responses": {
          "200": {
            "description": "취소 성공",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Application" } } }
          },
          "400": {
            "description": "이미 취소된 신청(applied 상태가 아님)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": {
            "description": "존재하지 않는 신청 id 또는 본인 소유가 아닌 신청 id",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/users/me": {
      "get": {
        "tags": ["users"],
        "summary": "내 정보 조회",
        "description": "FR-4.1 참조. password_hash는 응답에 포함되지 않는다.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "patch": {
        "tags": ["users"],
        "summary": "내 정보 수정",
        "description": "FR-4.1 참조. 이름/거래처명을 수정한다.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserUpdateRequest" } } }
        },
        "responses": {
          "200": {
            "description": "수정 성공",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/users/me/password": {
      "patch": {
        "tags": ["users"],
        "summary": "비밀번호 변경",
        "description": "FR-4.2 참조. 현재 비밀번호 검증 후 새 비밀번호로 변경한다.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PasswordChangeRequest" } } }
        },
        "responses": {
          "204": { "description": "변경 성공" },
          "400": {
            "description": "현재 비밀번호 불일치, 필수값 누락, 또는 new_password가 8자 미만",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    }
  }
}
